<ui:FluentWindow x:Class="MacroRelay.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="520"
                 Height="640"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">
    <ScrollViewer>
        <StackPanel Margin="16">
            <ui:TitleBar Title="Settings" />

            <TextBlock Text="Shortcuts" FontWeight="SemiBold" Margin="0,12,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Start all" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="StartAllBox" Margin="0,4" />
                <TextBlock Grid.Row="1" Text="Pause all" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PauseAllBox" Margin="0,4" />
                <TextBlock Grid.Row="2" Text="Stop all" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="StopAllBox" Margin="0,4" />
                <TextBlock Grid.Row="3" Text="Panic" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="PanicBox" Margin="0,4" />
                <TextBlock Grid.Row="4" Text="Record" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="RecordBox" Margin="0,4" />
            </Grid>

            <TextBlock Text="App" FontWeight="SemiBold" Margin="0,16,0,6" />
            <ComboBox x:Name="ThemeBox" Margin="0,0,0,8" />
            <CheckBox x:Name="CloseTrayBox" Content="Close to tray" Margin="0,4" />
            <CheckBox x:Name="StartMinBox" Content="Start minimized to tray" Margin="0,4" />
            <CheckBox x:Name="StartWinBox" Content="Start with Windows" Margin="0,4" />
            <CheckBox x:Name="UpdateLaunchBox" Content="Check for updates when the app opens" Margin="0,4" />

            <TextBlock Text="Defaults for new macros" FontWeight="SemiBold" Margin="0,16,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Interval (ms)" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IntervalBox" Margin="0,4" />
                <TextBlock Grid.Row="1" Text="Speed" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SpeedBox" Margin="0,4" />
                <TextBlock Grid.Row="2" Text="Jitter %" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="JitterBox" Margin="0,4" />
            </Grid>

            <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,16,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="GitHub owner" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="OwnerBox" Margin="0,4" />
            </Grid>
            <TextBlock x:Name="UpdateLabel" Margin="0,4,0,8" TextWrapping="Wrap" Opacity="0.8" />
            <Button Content="Check for updates" Click="CheckUpdates_OnClick" HorizontalAlignment="Left" />

            <TextBlock Text="Administrator" FontWeight="SemiBold" Margin="0,16,0,6" />
            <TextBlock x:Name="AdminLabel" Margin="0,0,0,8" TextWrapping="Wrap" />
            <Button x:Name="AdminButton" Content="Run as Administrator" Click="Admin_OnClick" HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Save" IsDefault="True" Click="Save_OnClick" Margin="0,0,8,0" />
                <Button Content="Close" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ui:FluentWindow>
