<Window x:Class="MacroRelay.App.Views.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a window"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="#66000000"
        Topmost="True"
        Cursor="Cross">
    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                Background="#DD111111" Padding="16,10" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Click the target window. Esc cancels." Foreground="White" FontSize="16" />
                <TextBlock x:Name="HoverLabel" Foreground="#CCC" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
