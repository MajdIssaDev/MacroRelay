<ui:FluentWindow x:Class="MacroRelay.App.Views.EditStepWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Edit step"
                 Width="460"
                 Height="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">
    <ScrollViewer>
        <StackPanel Margin="16">
            <ui:TitleBar Title="Edit step" />
            <TextBlock x:Name="TypeLabel" Margin="0,8,0,12" FontWeight="SemiBold" />

            <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                <TextBlock Text="Key" />
                <ComboBox x:Name="KeyBox" IsEditable="True" Margin="0,0,0,8" />
                <TextBlock Text="Action" />
                <ComboBox x:Name="KeyStrokeBox" Margin="0,0,0,8" />
                <TextBlock Text="Modifiers (Ctrl, Shift, Alt)" />
                <TextBox x:Name="ModsBox" Margin="0,0,0,8" />
            </StackPanel>

            <StackPanel x:Name="MousePanel" Visibility="Collapsed">
                <TextBlock Text="Button" />
                <ComboBox x:Name="MouseButtonBox" Margin="0,0,0,8" />
                <TextBlock Text="Action" />
                <ComboBox x:Name="MouseStrokeBox" Margin="0,0,0,8" />
                <TextBlock Text="X" />
                <TextBox x:Name="XBox" Margin="0,0,0,8" />
                <TextBlock Text="Y" />
                <TextBox x:Name="YBox" Margin="0,0,0,8" />
                <TextBlock Text="Coordinates" />
                <ComboBox x:Name="CoordBox" Margin="0,0,0,8" />
                <TextBlock Text="Wheel delta" />
                <TextBox x:Name="WheelBox" Margin="0,0,0,8" />
            </StackPanel>

            <StackPanel x:Name="DelayPanel" Visibility="Collapsed">
                <TextBlock Text="Milliseconds" />
                <TextBox x:Name="DelayBox" Margin="0,0,0,8" />
            </StackPanel>

            <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                <TextBlock Text="Method" />
                <ComboBox x:Name="TextMethodBox" Margin="0,0,0,8" />
                <TextBlock Text="Text" />
                <TextBox x:Name="BodyTextBox" AcceptsReturn="True" Height="120" TextWrapping="Wrap" Margin="0,0,0,8" />
            </StackPanel>

            <CheckBox x:Name="EnabledBox" Content="Enabled" Margin="0,8" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Save" IsDefault="True" Click="Save_OnClick" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ui:FluentWindow>
