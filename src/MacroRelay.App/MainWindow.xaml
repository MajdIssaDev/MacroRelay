<ui:FluentWindow x:Class="MacroRelay.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="MacroRelay"
                 Width="1280"
                 Height="800"
                 MinWidth="960"
                 MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding AddStepFromPaletteCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddMacroCommand}" />
    </ui:FluentWindow.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="MacroRelay" Grid.Row="0" />

        <Menu Grid.Row="1" Margin="12,0,12,4">
            <MenuItem Header="_File">
                <MenuItem Header="_Add macro" Command="{Binding AddMacroCommand}" />
                <MenuItem Header="_Import…" Command="{Binding ImportMacrosCommand}" />
                <MenuItem Header="_Export…" Command="{Binding ExportMacrosCommand}" />
                <Separator />
                <MenuItem Header="_Settings" Command="{Binding OpenSettingsCommand}" />
                <MenuItem Header="Minimize to _tray" Command="{Binding HideToTrayCommand}" />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Playback">
                <MenuItem Header="Start all" Command="{Binding StartAllCommand}" />
                <MenuItem Header="Pause all" Command="{Binding PauseAllCommand}" />
                <MenuItem Header="Stop all" Command="{Binding StopAllCommand}" />
                <MenuItem Header="Panic" Command="{Binding PanicCommand}" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="2" Margin="12,4,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="+" Width="36" Command="{Binding AddMacroCommand}" ToolTip="Add macro" />
                    <TextBlock Text="Macros" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="16" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Duplicate" Command="{Binding DuplicateMacroCommand}" Margin="0,0,6,0" />
                    <Button Content="Delete" Command="{Binding DeleteMacroCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Macros}"
                         SelectedItem="{Binding Selected}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StateLabel}" Opacity="0.7" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StateLabel}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="4" Margin="0,0,0,10">
                        <Button Content="Start all" Command="{Binding StartAllCommand}" Margin="0,0,6,0" />
                        <Button Content="Pause all" Command="{Binding PauseAllCommand}" Margin="0,0,6,0" />
                        <Button Content="Stop all" Command="{Binding StopAllCommand}" Margin="0,0,6,0" />
                        <Button Content="Panic" Command="{Binding PanicCommand}" />
                    </UniformGrid>

                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="18" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Start" Command="{Binding StartSelectedCommand}" Margin="0,0,6,0" />
                                <Button Content="Pause" Command="{Binding PauseSelectedCommand}" Margin="0,0,6,0" />
                                <Button Content="Stop" Command="{Binding StopSelectedCommand}" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Margin="0,0,16,8" MinWidth="140">
                                <TextBlock Text="Loop" Opacity="0.7" />
                                <ComboBox ItemsSource="{Binding LoopModes}" SelectedItem="{Binding Selected.LoopMode}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8" MinWidth="100">
                                <TextBlock Text="Repeat count" Opacity="0.7" />
                                <TextBox Text="{Binding Selected.RepeatCount, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8" MinWidth="140">
                                <CheckBox Content="Time limit (ms)" IsChecked="{Binding Selected.TimeLimitEnabled}" />
                                <TextBox Text="{Binding Selected.DurationMs, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8" MinWidth="120">
                                <TextBlock Text="Loop interval (ms)" Opacity="0.7" />
                                <TextBox Text="{Binding Selected.IntervalMs, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8" MinWidth="110">
                                <TextBlock Text="Speed" Opacity="0.7" />
                                <TextBox Text="{Binding Selected.Speed, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8" MinWidth="110">
                                <TextBlock Text="Jitter %" Opacity="0.7" />
                                <TextBox Text="{Binding Selected.JitterPercent, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8" MinWidth="140">
                                <TextBlock Text="Macro hotkey" Opacity="0.7" />
                                <TextBox Text="{Binding Selected.Hotkey, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </WrapPanel>

                        <GroupBox Header="Window target" Margin="0,0,0,10" Padding="8">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.TargetSummary}" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <ComboBox ItemsSource="{Binding PlaybackModes}" SelectedItem="{Binding Selected.PlaybackMode}" MinWidth="180" Margin="0,0,8,6" />
                                    <Button Content="Pick window" Command="{Binding PickWindowCommand}" Margin="0,0,8,6" />
                                    <Button Content="Clear" Command="{Binding ClearWindowCommand}" Margin="0,0,8,6" />
                                    <CheckBox Content="Advanced" IsChecked="{Binding AdvancedTarget}" VerticalAlignment="Center" Margin="0,0,8,6" />
                                </WrapPanel>
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"
                                           Text="Foreground uses the focused window. Focus target activates the app then sends input. Background messages try not to steal focus (Win32 apps only — not most games)." />
                                <Grid Visibility="{Binding AdvancedTarget, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Process" Opacity="0.7" />
                                        <TextBox Text="{Binding Selected.ProcessName, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Title contains" Opacity="0.7" />
                                        <TextBox Text="{Binding Selected.TitleContains, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="Class" Opacity="0.7" />
                                        <TextBox Text="{Binding Selected.ClassName, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="PID" Opacity="0.7" />
                                        <TextBox Text="{Binding Selected.ProcessId, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Steps" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <CheckBox Content="Keep delays" IsChecked="{Binding KeepDelays}" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <Button Content="Record" Command="{Binding ToggleRecordCommand}" Margin="0,0,6,4" />
                                <Button Content="Add step (Ctrl+K)" Command="{Binding AddStepFromPaletteCommand}" Margin="0,0,6,4" />
                                <Button Content="Edit" Command="{Binding EditStepCommand}" Margin="0,0,6,4" />
                                <Button Content="Up" Command="{Binding MoveStepUpCommand}" Margin="0,0,6,4" />
                                <Button Content="Down" Command="{Binding MoveStepDownCommand}" Margin="0,0,6,4" />
                                <Button Content="Delete step" Command="{Binding DeleteStepCommand}" Margin="0,0,0,4" />
                            </WrapPanel>
                        </DockPanel>

                        <ListBox x:Name="StepList"
                                 ItemsSource="{Binding Selected.Steps}"
                                 SelectedItem="{Binding SelectedStep}"
                                 MinHeight="220"
                                 MouseDoubleClick="StepList_OnMouseDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="StepContextMenu" />
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding RunningCount, StringFormat=Running: {0}}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding UpdateStatus}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding Version, StringFormat=v{0}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
